# Public hostname of this server. Its DNS A/AAAA record must point here and
# ports 80 + 443 must be open (Caddy gets a Let's Encrypt certificate).
AGENTRING_DOMAIN=relay.example.com

# Name the phone shows for your agent.
AGENTRING_AGENT_NAME=Claude

# Leave empty to have the relay generate one on first start (printed in the
# logs and saved in the relay-data volume). Must start with ak_ if you set it.
AGENTRING_API_KEY=

# Push notifications (see docs/firebase.md). Put both files in ./secrets/ and
# uncomment. Without them, messages only arrive while the app is open.
#FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
#FCM_GOOGLE_SERVICES_FILE=/secrets/google-services.json

# Calls (LiveKit). Media needs UDP 50000-50100 and TCP 7881 open on this server.
# This server's public IPv4, advertised to the phone for media. Leave empty to
# let LiveKit discover it over STUN.
LIVEKIT_NODE_IP=
# LiveKit API key id (not secret; letters, digits, _ and -). The matching secret
# is generated on first start and never leaves the server's Docker volumes.
LIVEKIT_API_KEY=agentring

# Optional daemon (docker compose --profile daemon up -d): extra `agentring serve`
# flags, e.g. --ai to answer the phone's calls with a voice AI (it needs
# GEMINI_API_KEY in the daemon's /config/.env: see docker-compose.yml).
#AGENTRING_SERVE_FLAGS=--ai

# Prebuilt release images instead of building locally (then: docker compose pull).
#AGENTRING_RELAY_IMAGE=ghcr.io/mutonby/agentring-relay:0.2.0
#AGENTRING_DAEMON_IMAGE=ghcr.io/mutonby/agentring-daemon:0.2.0

# iPhone push (optional; see docs/ios.md). Keep the .p8 key in secrets/.
#APNS_KEY_FILE=/secrets/AuthKey.p8
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_BUNDLE_ID=dev.agentring.ios
