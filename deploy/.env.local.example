# agentring on your own computer (docker-compose.local.yml). Copy to .env.local.

# This computer's address as the phone sees it: its LAN IP (same Wi-Fi, e.g. 192.168.1.20)
# or its Tailscale IP (100.x.y.z). Find it with `ipconfig getifaddr en0` (macOS),
# `hostname -I` (Linux) or `tailscale ip -4`. It must be a private address.
AGENTRING_HOST_IP=192.168.1.20

# Name the phone shows for your agent.
AGENTRING_AGENT_NAME=Claude

# Leave empty to have the relay generate one on first start (printed in the logs).
AGENTRING_API_KEY=

# Push notifications: needed for calls to ring while the phone is locked or the app is
# closed (docs/firebase.md). Put both files in ./secrets/ and uncomment.
#FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
#FCM_GOOGLE_SERVICES_FILE=/secrets/google-services.json

LIVEKIT_API_KEY=agentring

# iPhone push (optional; see docs/ios.md). Keep the .p8 key in secrets/.
#APNS_KEY_FILE=/secrets/AuthKey.p8
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_BUNDLE_ID=dev.agentring.ios
